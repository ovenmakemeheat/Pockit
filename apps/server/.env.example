NODE_ENV=development
HOST=0.0.0.0
PORT=3000
BETTER_AUTH_SECRET=replace-with-a-local-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
