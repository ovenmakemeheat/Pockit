{
  "name": "Pockit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.12",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@trpc/client": "^11.19.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "bun run db:generate && turbo run test --filter=web --filter=server --filter=@Pockit/api && turbo run test --filter=@Pockit/db",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @Pockit/db --",
    "db:studio": "turbo run db:studio -F @Pockit/db --",
    "db:generate": "turbo run db:generate -F @Pockit/db --",
    "db:migrate": "turbo run db:migrate -F @Pockit/db --",
    "db:migrate:deploy": "turbo run db:migrate:deploy -F @Pockit/db --",
    "db:dev:up": "docker compose -f docker-compose.db.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.db.yml down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Pockit/config": "workspace:*",
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write"
    ]
  },
  "packageManager": "bun@1.3.14"
}
