{
  "name": "@Pockit/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "varlock run -- bun test",
    "db:push": "bun ./node_modules/prisma/build/index.js db push",
    "db:generate": "bun ./node_modules/prisma/build/index.js generate",
    "db:migrate": "bun ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "bun ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "bun ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Pockit/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
